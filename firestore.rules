// Reglas SOLO para Eco Drive.
// IMPORTANTE: si tu proyecto de Firebase ya tiene otras apps, NO reemplaces tus reglas.
// Copia únicamente los dos bloques "match" de abajo dentro de tu "match /databases/{database}/documents { ... }".

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Eco Drive: pedidos -----
    match /ecodrive_pedidos/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.estado == 'buscando';
      allow update: if request.auth != null && (
        resource.data.clienteUid == request.auth.uid
        || resource.data.estado == 'buscando'
        || (resource.data.repartidor != null && resource.data.repartidor.uid == request.auth.uid)
      );

      match /ofertas/{repUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == repUid;
      }
    }

    // ----- Eco Drive: repartidores -----
    match /ecodrive_repartidores/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
